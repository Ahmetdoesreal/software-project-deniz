# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments and local package installs
.venv/
venv/
env/
ENV/
pip-wheel-metadata/

# Build and packaging output
build/
dist/
*.egg-info/
*.spec

# Editor and OS files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Runtime logs and crash/session traces
*.log
*.jsonl
install_logs/
logs/
data/logs/
**/data/logs/

# Runtime exam/client/server data that can contain student data or evidence
data/
**/data/client/
**/data/server/artifacts/
**/data/server/submissions/
**/data/server/session_audit.jsonl
**/data/server/incidents.jsonl
**/data/server/server_users.json

# Keep policy/config defaults that are safe and useful for deployments
!May_04_Deniz/data/
!May_04_Deniz/data/server/
!May_04_Deniz/data/server/exam_policy.json
!May_04_Deniz/data/server/incident_rules.json
!May_04_Deniz/data/server/process_blacklist.txt
!May_04_Deniz/data/server/process_definitions.json
!May_12/server/data/
!May_12/server/data/server/
!May_12/server/data/server/exam_policy.json
!May_12/server/data/server/incident_rules.json
!May_12/server/data/server/process_blacklist.txt
!May_12/server/data/server/process_definitions.json

# Generated recordings, submissions, archives, and evidence bundles
*.mp4
*.mkv
*.mov
*.avi
*.ts
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.zip
!test_exam.zip

# Offline installer payloads: keep scripts/manifests/docs, ignore heavy binaries
*.whl
*.exe
May_04_Deniz/offline_installer/wheelhouse/*
May_04_Deniz/offline_installer/installers/*
!May_04_Deniz/offline_installer/installers/
May_04_Deniz/offline_installer/ffmpeg/bin/*
May_12/setup/wheelhouse/*
May_12/setup/installers/*
May_12/setup/ffmpeg/bin/*
!May_04_Deniz/offline_installer/wheelhouse/.keep
!May_04_Deniz/offline_installer/installers/.keep
!May_04_Deniz/offline_installer/manifest.sha256
!May_12/setup/manifest.sha256

